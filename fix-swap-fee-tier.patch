-                "regime_loop: swap", f"Swap {direction} ({amount:.4f}) mislukt: {result.stderr[:200]}"
+                "regime_loop: swap", f"Swap {direction} ({amount:.4f}) mislukt: {result.stderr[-400:]}"
             )
