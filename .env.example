# Kopieer naar .env en vul in -- .env zelf NOOIT committen naar git.

# Hedera / wallet
HEDERA_BOT_PRIVATE_KEY=

# Anthropic (LLM sentiment engine)
ANTHROPIC_API_KEY=

# CryptoPanic (ruwe nieuws-feed, input voor de LLM sentiment engine)
CRYPTOPANIC_API_TOKEN=

# CoinGecko (optioneel, hogere rate limits)
COINGECKO_API_KEY=

# PostgreSQL (matcht docker-compose.yml)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://hbar_bot:${POSTGRES_PASSWORD}@database:5432/hbar_bot

# Telegram (notificaties)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Netwerk
HEDERA_NETWORK=testnet
